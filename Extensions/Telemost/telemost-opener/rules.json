{
  "schemaVersion": 1,
  "rules": [
    {
      "id": "telemost-j",
      "name": "Телемост: встречи",
      "enabled": true,
      "userToggleAllowed": true,
      "match": {
        "origins": [
          "https://telemost.yandex.ru",
          "https://telemost.360.yandex.ru"
        ],
        "pathname": "/j/{tail}",
        "hashRequired": false
      },
      "target": "telemost://{url}",
      "examples": [
        {
          "url": "https://telemost.yandex.ru/j/123456789",
          "appUrl": "telemost://https://telemost.yandex.ru/j/123456789"
        },
        {
          "url": "https://telemost.360.yandex.ru/j/123456789",
          "appUrl": "telemost://https://telemost.360.yandex.ru/j/123456789"
        }
      ]
    },
    {
      "id": "telemost-join",
      "name": "Телемост: чаты",
      "enabled": true,
      "userToggleAllowed": true,
      "match": {
        "origins": [
          "https://telemost.yandex.ru",
          "https://telemost.360.yandex.ru"
        ],
        "pathname": "/join",
        "hashRequired": true
      },
      "target": "telemost://ychat/{urlNoScheme}",
      "examples": [
        {
          "url": "https://telemost.yandex.ru/join#room123",
          "appUrl": "telemost://ychat/telemost.yandex.ru/join#room123"
        },
        {
          "url": "https://telemost.360.yandex.ru/join#room123",
          "appUrl": "telemost://ychat/telemost.360.yandex.ru/join#room123"
        }
      ]
    },
    {
      "id": "telemost-staff",
      "name": "Телемост: сотрудники",
      "enabled": true,
      "userToggleAllowed": true,
      "match": {
        "origins": [
          "https://telemost.yandex.ru",
          "https://telemost.360.yandex.ru"
        ],
        "pathname": "/staff/{tail}",
        "hashRequired": false
      },
      "target": "telemost://ychat/{host}{pathname}{hash}",
      "examples": [
        {
          "url": "https://telemost.yandex.ru/staff/person@example.net",
          "appUrl": "telemost://ychat/telemost.yandex.ru/staff/person@example.net"
        },
        {
          "url": "https://telemost.360.yandex.ru/staff/person@example.net",
          "appUrl": "telemost://ychat/telemost.360.yandex.ru/staff/person@example.net"
        }
      ]
    },
    {
      "id": "messenger-staff",
      "name": "Мессенджер: сотрудники",
      "enabled": true,
      "userToggleAllowed": true,
      "match": {
        "origins": [
          "https://messenger.360.yandex.ru"
        ],
        "pathname": "/",
        "hashPathname": "/staff/{tail}",
        "hashRequired": true
      },
      "target": "telemost://ychat/telemost.yandex.ru{hashPathname}",
      "examples": [
        {
          "url": "https://messenger.360.yandex.ru/#/staff/example-user",
          "appUrl": "telemost://ychat/telemost.yandex.ru/staff/example-user"
        },
        {
          "url": "https://messenger.360.yandex.ru/#/staff/person%40example.net",
          "appUrl": "telemost://ychat/telemost.yandex.ru/staff/person%40example.net"
        }
      ]
    },
    {
      "id": "messenger-join",
      "name": "Мессенджер: чаты в Телемост",
      "enabled": true,
      "userToggleAllowed": true,
      "match": {
        "origins": [
          "https://messenger.360.yandex.ru"
        ],
        "pathname": "/",
        "hashRequired": true,
        "queryKeys": [],
        "hashPathname": "/join/{p1}"
      },
      "target": "telemost://ychat/telemost.360.yandex.ru/join#{hashPath:1}",
      "examples": [
        {
          "url": "https://messenger.360.yandex.ru/#/join/a1b2c3",
          "appUrl": "telemost://ychat/telemost.360.yandex.ru/join#a1b2c3"
        },
        {
          "url": "https://messenger.360.yandex.ru/#/join/d4e5f6",
          "appUrl": "telemost://ychat/telemost.360.yandex.ru/join#d4e5f6"
        }
      ]
    }
  ]
}
