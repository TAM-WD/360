# Локальная проверка: реальные API и SMTP не используются.
DEMO_MODE=true
DEBUG=true
DJANGO_SECRET_KEY=local-demo-only-do-not-use-in-production-2f59ec
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
CSRF_TRUSTED_ORIGINS=
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0

YANDEX_ORG_ID=12345
# Название для текстов сайта; не заменяет числовой YANDEX_ORG_ID.
# Если оставить пустым, используется «нашей организации».
ORGANIZATION_NAME=""
YANDEX_DISK_TOKEN=
# Можно оставить пустым, если DISK_TOKEN имеет оба необходимых права.
YANDEX_DIRECTORY_TOKEN=
DIRECTORY_COOLDOWN_SECONDS=60
DIRECTORY_PAGE_SIZE=100
# Общий срок одного API-вызова, включая чтение ответа и повторные попытки.
API_DEADLINE_SECONDS=20

# file сохраняет письма в data/mail, smtp подключается к вашему серверу.
MAIL_TRANSPORT=file
MAIL_FROM=disk-access@company.example
MESSAGE_ID_DOMAIN=disk-access.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=15

# Docker Compose подставит DB_HOST=db автоматически. Для локального демо DB_HOST не задавайте.
DB_NAME=disk_access
DB_USER=disk_access
DB_PASSWORD=local-demo-change-before-deployment

# Порог на один IP: поиски за минуту и заявки за час.
LOOKUP_RATE_LIMIT=30
REQUEST_RATE_LIMIT=5
REQUEST_EMAIL_RATE_LIMIT=3
REQUEST_DEDUP_SECONDS=86400
